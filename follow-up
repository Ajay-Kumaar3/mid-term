# Follow-Up Bot Using ROS 1

## Aim

To implement a follow-up bot using ROS publishers and subscribers.

## Python Code — followup_bot.py

```python
#!/usr/bin/env python3
import rospy
import math
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose

pose = None

def pose_callback(data):
    global pose
    pose = data

rospy.init_node('followup_bot')

pub = rospy.Publisher('/turtle1/cmd_vel', Twist, queue_size=10)
rospy.Subscriber('/turtle1/pose', Pose, pose_callback)

rate = rospy.Rate(10)

while pose is None and not rospy.is_shutdown():
    rate.sleep()

velocity = Twist()

while not rospy.is_shutdown():
    dx = 8.0 - pose.x
    dy = 8.0 - pose.y

    distance = math.sqrt(dx**2 + dy**2)
    angle = math.atan2(dy, dx)

    error = math.atan2(
        math.sin(angle - pose.theta),
        math.cos(angle - pose.theta)
    )

    if distance < 0.2:
        velocity.linear.x = 0.0
        velocity.angular.z = 0.0
    else:
        velocity.linear.x = min(1.5, distance) if abs(error) < 0.2 else 0.0
        velocity.angular.z = 4.0 * error

    pub.publish(velocity)
    rate.sleep()
```


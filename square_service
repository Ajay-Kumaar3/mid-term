# Q12: Draw a Square Using ROS Service

## Aim
To create a custom ROS service that makes the turtlesim turtle draw a square.

## 1. Service Definition — DrawSquare.srv

Location: `ros_exam_pkg/srv/DrawSquare.srv`

```text
float64 side_length
---
bool success
string message
```

- Request: length of each side.
- Response: success status and message.

## 2. Service Server — square_server.py

Location: `ros_exam_pkg/scripts/square_server.py`

```python
#!/usr/bin/env python3
import rospy
import time
from geometry_msgs.msg import Twist
from ros_exam_pkg.srv import DrawSquare, DrawSquareResponse

pub = None

def handle_square(req):
    if req.side_length <= 0:
        return DrawSquareResponse(False, "Invalid side length")

    velocity = Twist()
    rate = rospy.Rate(10)

    for i in range(4):
        velocity.linear.x = 1.0
        velocity.angular.z = 0.0

        start = time.time()
        while time.time() - start < req.side_length and not rospy.is_shutdown():
            pub.publish(velocity)
            rate.sleep()

        velocity = Twist()
        velocity.angular.z = 1.57

        start = time.time()
        while time.time() - start < 1.0 and not rospy.is_shutdown():
            pub.publish(velocity)
            rate.sleep()

    pub.publish(Twist())

    return DrawSquareResponse(True, "Square completed")

rospy.init_node('square_server')

pub = rospy.Publisher('/turtle1/cmd_vel', Twist, queue_size=10)

service = rospy.Service('draw_square', DrawSquare, handle_square)

rospy.loginfo("Square service is ready")
rospy.spin()
```

## 3. Service Client — square_client.py

Location: `ros_exam_pkg/scripts/square_client.py`

```python
#!/usr/bin/env python3
import rospy
from ros_exam_pkg.srv import DrawSquare

rospy.init_node('square_client')

rospy.wait_for_service('draw_square')

draw_square = rospy.ServiceProxy('draw_square', DrawSquare)

response = draw_square(2.0)

print(response.message)
print("Success:", response.success)
```

